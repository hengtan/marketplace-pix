    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Degradation responses at the gateway",
      "description": "429 (rate limited), 503 (circuit open or bulkhead) and 504 (deadline or timeout) per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
