    {
      "id": 19,
      "type": "row",
      "title": "SLO do gateway (disponibilidade 99,5% e latência 95% abaixo de 500 ms)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Orçamento de erro restante (1d)",
      "description": "Quanto do orçamento de disponibilidade (0,5%) ainda não foi consumido na janela de 1 dia. Abaixo de 0 significa SLO estourado.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 65
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (slo:gateway_error_ratio:rate1d / 0.005)",
          "legendFormat": "orçamento",
          "refId": "A",
          "instant": true
        }
