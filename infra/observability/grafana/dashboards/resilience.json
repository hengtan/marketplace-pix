      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name, event) (rate(resilience_retry_events_total[1m]))",
          "legendFormat": "{{name}} {{event}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Bulkhead: running and queued",
