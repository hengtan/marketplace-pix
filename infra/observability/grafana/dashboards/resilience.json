        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(resilience_rate_limit_decisions_total{result=\"limited\"}[5m])) / clamp_min(sum(rate(resilience_rate_limit_decisions_total[5m])), 1e-9)",
          "legendFormat": "429 / total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Who answered the limit: Redis or fallback",
      "description": "redis = normal; memory_fallback = per-instance local limiter; fail_open = let it through; fail_closed = blocked.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
