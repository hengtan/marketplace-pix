    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Decisões do rate limit por rota",
      "description": "Permitidas e limitadas (429) por rota, por segundo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
