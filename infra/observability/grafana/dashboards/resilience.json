    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Share of rate-limited requests (429)",
      "description": "Limited over total decisions (5m).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
