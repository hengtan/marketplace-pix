    {
      "id": 19,
      "type": "row",
      "title": "Gateway SLO (99.5% availability and 95% of latency below 500 ms)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Error budget remaining (1d)",
      "description": "How much of the availability budget (0.5%) is still unspent in the 1 day window. Below 0 means the SLO is blown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 65
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (slo:gateway_error_ratio:rate1d / 0.005)",
          "legendFormat": "budget",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Availability burn rate (1h)",
      "description": "Budget burn speed: 1 = sustainable consumption, 14.4 = page alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 65
      },
