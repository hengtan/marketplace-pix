        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(assistant_cache_requests_total{result=\"hit\"}[$__range])) / clamp_min(sum(increase(assistant_cache_requests_total{result=~\"hit|miss\"}[$__range])), 1)",
          "legendFormat": "",
          "refId": "A"
